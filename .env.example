# Share this calendar with the service account as "Make changes to events".
GOOGLE_CALENDAR_ID=yoni.insell@twosteps.ai

# Either a JSON key blob:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Or split fields:
GOOGLE_CLIENT_EMAIL=booking@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional (defaults below)
# BOOK_TZ=Asia/Jerusalem
