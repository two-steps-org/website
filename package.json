{
  "name": "two-steps-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:ssg",
    "build:ssg": "export SEO_ENV=production VITE_SEO_ENV=production; tsc --noEmit && vite build && node --import tsx scripts/prerender.ts && node scripts/optimize-modulepreloads.mjs && node --import tsx scripts/generate-sitemap.ts && node --import tsx scripts/verify-seo-html.ts && node scripts/check-performance-budget.mjs",
    "build:seo:staging": "export SEO_ENV=staging VITE_SEO_ENV=staging; tsc --noEmit && vite build && node --import tsx scripts/prerender.ts && node --import tsx scripts/generate-sitemap.ts && node --import tsx scripts/verify-seo-html.ts",
    "seo:verify": "node --import tsx scripts/verify-seo-html.ts",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3"
  },
